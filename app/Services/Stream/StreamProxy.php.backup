<?php
/**
 * Zonaotaku v2-final-cpanel
 * File   : app/Services/Stream/StreamProxy.php
 * Fungsi : range-aware pass-through proxy, guard magic-byte, chunk 2MiB, micro-gap, deteksi HLS.
 * Rujuk  : ZONAOTAKU_V2_FINAL.md §4.3, §12.1 B5
 */
declare(strict_types=1);

namespace App\Services\Stream;

use App\Services\Animeku\AnimekuClient;
use App\Services\Security\AuditWriter;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Throwable;

final class StreamProxy
{
    public function __construct(
        private readonly TokenService $tokens,
        private readonly QualityResolver $qualities,
        private readonly AdmissionControl $admission,
        private readonly AuditWriter $audit,
        private readonly AnimekuClient $client
    ) {}

    public function handle(Request $request, string $token): StreamedResponse
    {
        $ip = $request->ip();
        $ua = $request->userAgent();

        // 1. Validasi Token
        $verify = $this->tokens->verifyPlayToken($token, $ip, $ua);
        if (!$verify['ok']) {
            $this->audit->write('stream.denied', $verify['payload']['uid'] ?? 0, 'Stream', null, ['stage' => 'token', 'reason' => $verify['reason']]);
            abort(403, 'Token stream tidak valid.');
        }

        $payload = $verify['payload'];
        $episodeId = $payload['eid'];
        $quality = $payload['q'];
        $userId = $payload['uid'];

        // 2. Admission Control (Lazy Prune)
        if (!$this->admission->allow($userId)) {
            $this->audit->write('stream.admission_reject', $userId, 'Stream', null, ['quality' => $quality]);
            abort(503, 'Server stream padat.');
        }

        // 3. Ambil URL dari DB (via Episode model - asumsi sudah ada)
        // Note: Di implementasi nyata, ambil dari Episode::find($episodeId)->quality_urls
        // Di sini kita pakai placeholder logic untuk struktur.
        $episode = \App\Models\Episode::find($episodeId);
        if (!$episode) abort(404);

        $qualityUrls = $episode->quality_urls ?? [];
        $url = $qualityUrls[$quality] ?? null;

        if (!$url) {
            // Fallback kualitas
            $fallback = $this->qualities->fallback($quality);
            if ($fallback && isset($qualityUrls[$fallback])) {
                $url = $qualityUrls[$fallback];
                $quality = $fallback;
            } else {
                abort(410, 'Kualitas stream tidak tersedia.');
            }
        }

        // 4. Guard SSRF & Whitelist
        $this->client->guardUrl($url); // Pakai method guard dari AnimekuClient

        // 5. Range Parsing
        $rangeHeader = $request->header('Range');
        $range = null;
        if ($rangeHeader && preg_match('/bytes=(\d+)-(\d*)/', $rangeHeader, $m)) {
            $start = (int) $m[1];
            $end = isset($m[2]) && $m[2] !== '' ? (int) $m[2] : null;
            $range = $end !== null ? "{$start}-{$end}" : "{$start}-";
        }

        // 6. Upstream Request & Streaming
        return new StreamedResponse(function () use ($url, $range, $quality, $userId, $token) {
            $this->streamFromUpstream($url, $range, $quality, $userId, $token);
        }, 206, [
            'Content-Type' => 'video/mp4',
            'Accept-Ranges' => 'bytes',
            'Cache-Control' => 'no-store, no-cache, must-revalidate, proxy-revalidate',
            'Pragma' => 'no-cache',
            'X-Accel-Buffering' => 'no',
        ]);
    }

    private function streamFromUpstream(string $url, ?string $range, string $quality, int $userId, string $token): void
    {
        $chunkSize = (int) config('zonaotaku.stream.chunk_size', 2097152); // 2MB
        $headers = [
            'User-Agent' => config('zonaotaku.animeku.ua'),
            'Referer' => config('zonaotaku.animeku.base_url'),
            'Accept' => '*/*',
        ];
        if ($range) $headers['Range'] = "bytes={$range}";

        try {
            $response = Http::withHeaders($headers)
                ->withOptions(['stream' => true, 'allow_redirects' => false])
                ->get($url);

            if ($response->status() >= 400) {
                $this->audit->write('stream.guard_fail', $userId, 'Stream', null, ['status' => $response->status()]);
                return;
            }

            $stream = $response->toPsrResponse()->getBody();
            $isFirstChunk = true;
            $bytesSent = 0;

            while (!$stream->eof()) {
                $chunk = $stream->read($chunkSize);
                if ($chunk === '') break;

                // Guard Magic Byte MP4 (Hanya chunk pertama)
                if ($isFirstChunk) {
                    if (!str_contains($chunk, 'ftyp') && !str_contains($chunk, 'moov')) {
                        // Deteksi HLS (V3 Stub)
                        if (str_contains($chunk, '#EXTM3U')) {
                            // TODO-OWNER: Implementasi HLS rewrite/parser untuk [V3]
                            $this->audit->write('stream.hls_detected', $userId, 'Stream', null, ['mode' => 'hls_stub']);
                        }
                        $this->audit->write('stream.guard_fail', $userId, 'Stream', null, ['reason' => 'invalid_magic']);
                        break;
                    }
                    $isFirstChunk = false;
                }

                echo $chunk;
                if (ob_get_level() > 0) ob_flush();
                flush();
                $bytesSent += strlen($chunk);

                // Anti LVE Burst & Time Limit
                usleep(1000); // 1ms gap
                set_time_limit(60);
            }

            // Register admission setelah stream mulai (atau bisa di awal)
            $this->admission->register($userId, hash('sha256', $token));

        } catch (Throwable $e) {
            $this->audit->write('stream.upstream_error', $userId, 'Stream', null, ['error' => $e->getMessage()]);
        }
    }
}
